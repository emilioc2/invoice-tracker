# Base URL of the InvoiceTracker.Api backend.
# NOTE: launchSettings.json currently binds the API to an OS-assigned ephemeral port
# (http://localhost:0), not a fixed one, and there is no CORS policy configured yet — both are
# backend concerns to confirm/fix before this can be exercised against a real running API
# (needed starting step 11, the real login flow). Update this value once the local port is
# pinned down.
VITE_API_BASE_URL=http://localhost:5000
