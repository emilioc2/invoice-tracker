# Base URL of the InvoiceTracker.Api backend.
# The http launch profile is pinned to this port (backend/src/InvoiceTracker.Api/Properties/
# launchSettings.json) and the API's CORS policy (Cors:AllowedOrigins in appsettings.Development.json)
# allows this Vite dev server's origin (http://localhost:5173) by default — run the API with
# `dotnet run --launch-profile http` to match.
VITE_API_BASE_URL=http://localhost:5100
